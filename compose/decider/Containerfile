# Keera Decider: Laya's server, laya-serve, on CPU, as Laya publishes no image.
# The gateway calls its /v1/systemone endpoint for models of kind decision; see
# docs/gateway.md#decision-models.
FROM docker.io/library/python:3.14-slim

# The CPU build of torch, to skip 3 GB of CUDA libraries the model does not
# need.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.15.0+cpu "laya[serve]==0.4.17"

ENV HF_HOME=/root/.cache/huggingface \
    LAYA_DEVICE=cpu \
    LAYA_PRELOAD=1 \
    LAYA_MODELS=english
EXPOSE 8000
CMD ["laya-serve"]
