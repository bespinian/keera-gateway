# Copy to .env. podman compose reads it from this directory automatically.
# `make dev` reads it as a shell script too, so quote a value with spaces.
# docs/install.md explains every setting; compose/README.md says which ones
# compose.yaml passes on.

# Credential for the control API and the CLI. Required: openssl rand -hex 32
KEERA_OPERATOR_KEY=

# Encrypts stored API keys and sign-in tokens. Required: openssl rand -hex 32
KEERA_SECRET_KEY=

# Reads /metrics and nothing else, so scrapers need not hold the operator key.
#KEERA_METRICS_TOKEN=

# How long usage and audit entries are kept. Both default to for ever.
# See "Retention and sizing" in docs/install.md.
#KEERA_USAGE_RETENTION=8760h
#KEERA_AUDIT_RETENTION=17520h

# Idle time that ends a task on the Sessions screen. See docs/sessions.md.
#KEERA_SESSION_GAP=30m

# Interface the one port is published on. It serves the panel and the control
# API too (docs/gateway.md), so keep 127.0.0.1 until TLS is in front.
# `make dev` ignores it and listens on KEERA_ADDR (:8080).
KEERA_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Inference backend: llama.cpp on CPU, or vLLM with compose.gpu.yaml.
# See compose/README.md.
# ---------------------------------------------------------------------------

# A GGUF repository and, after the colon, the quantisation (default Q4_K_M).
#KEERA_LLAMA_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF:Q4_K_M
#KEERA_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# The GPU tier's model and image. compose/README.md lists other choices.
#KEERA_GPU_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
#KEERA_VLLM_IMAGE=docker.io/vllm/vllm-openai:latest
# /dev/shm for vLLM. 8gb is the floor for one card.
#KEERA_SHM_SIZE=8gb

# ---------------------------------------------------------------------------
# Single sign-on and passkeys. See docs/sso.md.
# ---------------------------------------------------------------------------

# One sign-in button per name. Do not rename one later.
#KEERA_OIDC_PROVIDERS=google,entra
#KEERA_OIDC_GOOGLE_ISSUER=https://accounts.google.com
#KEERA_OIDC_GOOGLE_CLIENT_ID=
#KEERA_OIDC_GOOGLE_CLIENT_SECRET=
# The email domains this provider may vouch for. Never "*" on Entra.
#KEERA_OIDC_GOOGLE_DOMAINS=*
# Lets people with no organisation create one.
#KEERA_OIDC_GOOGLE_SIGNUP=true
# Required with sign-up: the private hosts organisations may reach.
# See docs/install.md.
#KEERA_UPSTREAM_PRIVATE=keera-engine
#KEERA_OIDC_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
#KEERA_OIDC_ENTRA_CLIENT_ID=
#KEERA_OIDC_ENTRA_CLIENT_SECRET=
#KEERA_OIDC_ENTRA_DOMAINS=anotherbank.ch
# App roles instead of groups, which Entra sends as GUIDs.
#KEERA_OIDC_ENTRA_GROUPS_CLAIM=roles
# Setting admin groups lets the directory, not Keera, decide administrators.
#KEERA_OIDC_ENTRA_ADMIN_GROUPS=keera-admins
#KEERA_OIDC_ENTRA_OPERATOR_GROUPS=keera-operators
# Role for a person who matches no group and no address.
#KEERA_OIDC_ENTRA_DEFAULT_ROLE=member

# Accounts that sign in with a passkey instead of a directory.
#KEERA_PASSKEYS=true

# Emails that are operators, whichever provider signs them in.
#KEERA_OPERATORS=you@example.ch

# Claude Code on a Claude plan. See docs/subscriptions.md.
#KEERA_CLAUDE_SUBSCRIPTIONS=true

# The gateway as a browser reaches it. Needed for SSO and payments.
#KEERA_PUBLIC_URL=https://keera.example.ch

# The deployment's own provider keys, and payment by card. See docs/billing.md.
#KEERA_PROVIDER_ANTHROPIC_API_KEY=sk-ant-...
#KEERA_POSTFINANCE_SPACE_ID=
#KEERA_POSTFINANCE_USER_ID=
#KEERA_POSTFINANCE_AUTH_KEY=
#KEERA_BILLING_CHF_PER_USD=0.80

# Most other settings in docs/install.md can go here too, such as
# KEERA_CURRENCY or KEERA_REDIS_URL.

# ---------------------------------------------------------------------------
# Sandboxes. Only `make dev` reads these. See compose/README.md and
# docs/sandboxes.md#configuration. Before the first one: make sandbox-image
# ---------------------------------------------------------------------------

# podman, or empty for no sandboxes.
#KEERA_SANDBOX_DRIVER=podman
# The classes each new organisation starts with.
#KEERA_SANDBOXES_FILE=compose/sandboxes.yaml
#KEERA_SANDBOX_PODMAN_BINARY=podman
#KEERA_SANDBOX_PODMAN_NETWORK=
# The gateway as a sandbox reaches it. Not 127.0.0.1.
#KEERA_SANDBOX_PUBLIC_URL=http://host.containers.internal:8080
# An OCI runtime per isolation tier. A tier without one is refused.
#KEERA_SANDBOX_RUNTIME_STANDARD=crun
#KEERA_SANDBOX_RUNTIME_ISOLATED=runsc
#KEERA_SANDBOX_RUNTIME_VM=krun
# Suspend a sandbox nobody is attached to after this long.
#KEERA_SANDBOX_IDLE_SUSPEND=45m
# Where sandboxes clone from: github or gitlab.
#KEERA_SANDBOX_GIT_FORGE=gitlab
#KEERA_SANDBOX_GIT_URL=https://gitlab.example.ch
#KEERA_SANDBOX_GIT_TOKEN_FILE=/run/secrets/keera-gitlab-token
# For GitHub, a GitHub App instead of a token:
#KEERA_SANDBOX_GIT_APP_ID=123456
#KEERA_SANDBOX_GIT_APP_KEY_FILE=/run/secrets/keera-github-app.pem
