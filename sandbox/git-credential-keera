#!/bin/sh
# git-credential-keera: gives git this sandbox's repository credential.
#
# The gateway minted it when the sandbox was created, for one repository. A
# GitHub token lasts an hour and a sandbox can last a day, so when the token
# is about to run out this asks the gateway for a fresh one, with the
# sandbox's own key. That stops working when the sandbox ends or its owner is
# disabled.
#
# It only answers for the repository's own host, so a submodule or a remote
# pointing anywhere else never sees the token.
set -eu

cache="$HOME/.config/keera/git-credential"

case "${1:-}" in
  get) ;;
  erase)
    # git says the credential was refused, so the next `get` asks for a new one.
    rm -f "$cache"
    exit 0
    ;;
  *) exit 0 ;;
esac

# A shell that did not come through sshd has none of the sandbox's variables.
if [ -z "${KEERA_REPO:-}" ] && [ -f "$HOME/.ssh/environment" ]; then
  set -a
  . "$HOME/.ssh/environment"
  set +a
fi

host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done
repo_host="$(printf '%s' "${KEERA_REPO:-}" | sed -E 's#^[a-z]+://([^/@]*@)?([^/]+)/.*#\2#')"
[ -n "$host" ] && [ "$host" = "$repo_host" ] || exit 0

# Fresh means more than five minutes left, so a clone that starts now finishes
# on the same token. No expiry means it does not run out.
fresh() {
  [ -s "$cache" ] || return 1
  expiry="$(sed -n 's/^password_expiry_utc=//p' "$cache")"
  [ -z "$expiry" ] || [ "$expiry" -gt $(($(date +%s) + 300)) ]
}

if ! fresh; then
  if [ -z "${KEERA_GIT_CREDENTIAL_URL:-}" ] || [ -z "${KEERA_API_KEY:-}" ]; then
    echo "keera: this sandbox's repository credential has run out, and there is no gateway to ask for a new one" >&2
    exit 0
  fi
  umask 077
  mkdir -p "${cache%/*}"
  # The key goes in on stdin, so it is not in the process list.
  if ! printf 'Authorization: Bearer %s\n' "$KEERA_API_KEY" |
    curl -fsS --max-time 30 -X POST -H @- "$KEERA_GIT_CREDENTIAL_URL" > "$cache.new"; then
    rm -f "$cache.new"
    echo "keera: could not get a fresh repository credential from the gateway" >&2
    exit 0
  fi
  mv "$cache.new" "$cache"
fi
cat "$cache"
