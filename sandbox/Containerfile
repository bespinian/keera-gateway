# The Keera sandbox image.
#
# A sandbox is a machine somebody works in, so this image carries the toolchain
# already installed rather than fetching it on start. That is not only about
# waiting: an air-gapped customer's cluster cannot reach a package index at all,
# so a sandbox that installs its own toolchain is a sandbox that never becomes
# ready there.
#
# It is a base rather than the answer. A deployment builds its own on top of
# this with the languages, the language servers and the internal certificates
# its engineers actually need, and sets it as a sandbox class's image. What
# this layer owns is the part the gateway depends on: the user, the home
# directory, sshd, the coding agent, and the entrypoint that turns a container
# into a workstation.
#
#   make sandbox-image
#   podman build -t registry.internal/keera/sandbox-base:1 sandbox
#
# The build context is this directory, not the repository root.

FROM docker.io/library/alpine:3.24

# The sandbox user is keera, uid 1000, with its home at /home/keera.
#
# Fixed rather than taken from the base image, because the home volume is
# provisioned with this uid as its fsGroup - a uid that moved between image
# versions would be a sandbox that could not write to its own home after an
# upgrade. Both of the gateway's drivers and sshd_config hard-code the same
# uid and home, so none of them can change here alone.

# No locale package and no LANG beyond this: musl is UTF-8 throughout and has no
# locale system to configure.
ENV LANG=C.UTF-8 \
    HOME=/home/keera

# nodejs is here for the coding agent below. Alpine 3.24 carries 24.18, which is
# comfortably past what Pi requires (>= 22.19).
RUN apk add --no-cache \
      bash \
      ca-certificates \
      curl \
      git \
      git-lfs \
      gnupg \
      jq \
      less \
      nodejs \
      npm \
      openssh-server \
      openssh-client \
      procps-ng \
      ripgrep \
      rsync \
      shadow \
      tini \
      tmux \
      unzip \
      vim \
      zsh

# The Pi coding agent, pinned with everything under it.
#
# Pinned because a sandbox image is a thing a deployment builds once and runs
# for months: an unpinned agent would mean two sandboxes from the same catalogue
# entry running different software, which is the property a class name exists to
# prevent. Pi's npm package no longer pins its own dependencies, so the lockfile
# in sandbox/pi does. To move to a newer Pi, change the version in
# sandbox/pi/package.json and run `npm install --package-lock-only` there.
# --ignore-scripts because Pi needs no install scripts, and nothing else then
# runs code at build time.
COPY pi/package.json pi/package-lock.json /opt/pi/
RUN npm ci --prefix /opt/pi --omit=dev --ignore-scripts \
 && npm cache clean --force \
 && ln -s /opt/pi/node_modules/.bin/pi /usr/local/bin/pi \
 && pi --version

RUN addgroup -g 1000 keera \
 && adduser -u 1000 -G keera -h /home/keera -s /bin/bash -D -H keera \
 # The home directory exists in the image so that it is a mount point with the
 # right owner before anything is mounted over it. Without it the volume arrives
 # owned by root and the entrypoint cannot write the one file that makes the
 # sandbox reachable.
 && mkdir -p /home/keera \
 && chown 1000:1000 /home/keera

# sshd needs somewhere to write its runtime state, and a host key.
#
# The host key is generated at build time and is therefore the same for every
# sandbox from this image, which would be alarming anywhere else and is fine
# here: the host key is not what proves which sandbox you reach. The connection
# goes through the gateway's attach surface, which is TLS to an
# already-authenticated caller, and out the other side to an address the
# gateway dialled itself. That is why `keera sandbox ssh` and `keera sandbox
# config` turn host-key checking off.
RUN mkdir -p /run/sshd /etc/ssh/keera \
 && ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/keera/ssh_host_ed25519_key \
 && chown -R 1000:1000 /run/sshd /etc/ssh/keera

COPY sshd_config /etc/ssh/keera/sshd_config
COPY entrypoint.sh /usr/local/bin/keera-sandbox
COPY agent.sh /usr/local/bin/keera-agent
COPY git-credential-keera /usr/local/bin/git-credential-keera
RUN chmod 0755 /usr/local/bin/keera-sandbox /usr/local/bin/keera-agent \
      /usr/local/bin/git-credential-keera \
 && chmod 0644 /etc/ssh/keera/sshd_config

USER 1000
WORKDIR /home/keera

# tini, because a sandbox is a machine: somebody will start a background
# process, an agent will spawn a test runner, and PID 1 has to reap what they
# leave behind. Without it a long-lived sandbox accumulates zombies until it
# cannot fork.
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/keera-sandbox"]
