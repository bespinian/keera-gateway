# The Keera sandbox image.
#
# The toolchain is installed in the image, not fetched on start: an air-gapped
# cluster cannot reach a package index, so such a sandbox would never be ready.
#
# It is a base. A deployment builds its own on top with the languages, language
# servers and internal certificates its engineers need, and sets it as a sandbox
# class's image. This layer owns what the gateway depends on: the user, the home
# directory, sshd, the coding agent, and the entrypoint.
#
#   make sandbox-image
#   podman build -t registry.internal/keera/sandbox-base:1 sandbox
#
# The build context is this directory, not the repository root.

FROM docker.io/library/alpine:3.24

# The sandbox user is keera, uid 1000, with its home at /home/keera.
#
# Fixed, because the home volume is provisioned with this uid as its fsGroup: a
# uid that changed between versions could not write to its home after an
# upgrade. Both drivers and sshd_config hard-code the same uid and home, so
# none can change here alone.

# No locale package: musl is UTF-8 throughout and has no locales to configure.
ENV LANG=C.UTF-8 \
    HOME=/home/keera

# nodejs is for the coding agent below. Alpine 3.24 has 24.18; Pi needs >= 22.19.
RUN apk add --no-cache \
      bash \
      ca-certificates \
      curl \
      git \
      git-lfs \
      gnupg \
      jq \
      less \
      nodejs \
      npm \
      openssh-server \
      openssh-client \
      procps-ng \
      ripgrep \
      rsync \
      shadow \
      tini \
      tmux \
      unzip \
      vim \
      zsh

# The Pi coding agent, pinned with everything under it.
#
# Pinned so two sandboxes of the same class run the same software. Pi's npm
# package does not pin its dependencies, so the lockfile in sandbox/pi does. To
# update Pi, change the version in sandbox/pi/package.json and run
# `npm install --package-lock-only` there. --ignore-scripts because Pi needs no
# install scripts, so nothing else runs code at build time.
COPY pi/package.json pi/package-lock.json /opt/pi/
RUN npm ci --prefix /opt/pi --omit=dev --ignore-scripts \
 && npm cache clean --force \
 && ln -s /opt/pi/node_modules/.bin/pi /usr/local/bin/pi \
 && pi --version

RUN addgroup -g 1000 keera \
 && adduser -u 1000 -G keera -h /home/keera -s /bin/bash -D -H keera \
 # The home directory exists in the image so it is a mount point with the right
 # owner. Otherwise the volume arrives owned by root and the entrypoint cannot
 # write the file that makes the sandbox reachable.
 && mkdir -p /home/keera \
 && chown 1000:1000 /home/keera

# sshd needs somewhere to write its runtime state, and a host key.
#
# The host key is the same for every sandbox from this image. That is fine: the
# connection goes through the gateway's authenticated attach surface to an
# address the gateway dialled itself, so the host key proves nothing. That is
# why `keera sandbox ssh` and `keera sandbox config` turn host-key checking off.
RUN mkdir -p /run/sshd /etc/ssh/keera \
 && ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/keera/ssh_host_ed25519_key \
 && chown -R 1000:1000 /run/sshd /etc/ssh/keera

COPY --chmod=0644 sshd_config /etc/ssh/keera/sshd_config
COPY --chmod=0755 entrypoint.sh /usr/local/bin/keera-sandbox
COPY --chmod=0755 agent.sh /usr/local/bin/keera-agent
COPY --chmod=0755 git-credential-keera /usr/local/bin/git-credential-keera

USER 1000
WORKDIR /home/keera

# tini reaps the processes people and agents leave behind. Without it a
# long-lived sandbox gathers zombies until it cannot fork.
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/keera-sandbox"]
