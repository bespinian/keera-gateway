# sshd inside a Keera sandbox.
#
# It runs as the sandbox user, with no privilege separation: there is one
# account. PortSSH in internal/sandbox/sandbox.go explains port 2222.
#
# Only the key the gateway put in authorized_keys signs in. No password.

Port 2222
AddressFamily inet
ListenAddress 0.0.0.0

HostKey /etc/ssh/keera/ssh_host_ed25519_key
PidFile /run/sshd/sshd.pid

# What the gateway set, handed to every session.
#
# An ssh session does not inherit the container's environment, and shell
# startup files miss non-interactive sessions such as scp. So sshd reads it
# from ~/.ssh/environment. The usual LD_PRELOAD worry does not apply: there is
# one account, and the entrypoint writes the file before sshd starts.
PermitUserEnvironment yes

# The only way in.
PubkeyAuthentication yes
AuthorizedKeysFile /home/keera/.ssh/authorized_keys
PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM no

# A shell, an editor's remote server, scp, and ports forwarded to the laptop.
AllowTcpForwarding yes
# A forwarded agent would let a model's output sign with the developer's keys.
AllowAgentForwarding no
PermitTunnel no
X11Forwarding no
Subsystem sftp internal-sftp

# The gateway's idle watchdog is in hours. This releases the pty soon after a
# client vanishes.
ClientAliveInterval 60
ClientAliveCountMax 10

AcceptEnv LANG LC_* TERM
PrintMotd no
