# sshd inside a Keera sandbox.
#
# It runs as the sandbox user, with no privilege separation: there is one
# account. Why port 2222 is explained at PortSSH in internal/sandbox/sandbox.go.
#
# Authentication is by the key the gateway put in authorized_keys when the
# sandbox was created. The account has no password.

Port 2222
AddressFamily inet
ListenAddress 0.0.0.0

HostKey /etc/ssh/keera/ssh_host_ed25519_key
PidFile /run/sshd/sshd.pid

# What the gateway set, handed to every session.
#
# An ssh session does not inherit the container's environment, so a shell would
# have no gateway address and no API key. Shell startup files are not enough: a
# non-interactive `ssh host cmd`, as scp and editors' remote servers use, reads
# ~/.bashrc only on some bash builds, not Alpine's.
#
# So sshd injects it from ~/.ssh/environment for every session. The usual worry,
# a user setting LD_PRELOAD for a privileged login, does not apply: the only
# account is the sandbox's owner, and the entrypoint writes the file before sshd
# starts.
PermitUserEnvironment yes

# The only way in.
PubkeyAuthentication yes
AuthorizedKeysFile /home/keera/.ssh/authorized_keys
PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM no

# A shell, an editor's remote server, scp, and ports forwarded to the laptop.
AllowTcpForwarding yes
# An agent forwarded into a machine that runs a model's output would sign with
# the developer's keys.
AllowAgentForwarding no
PermitTunnel no
X11Forwarding no
Subsystem sftp internal-sftp

# The gateway's attach surface has an idle watchdog measured in hours. This finer
# one releases the pty soon after a client vanishes.
ClientAliveInterval 60
ClientAliveCountMax 10

AcceptEnv LANG LC_* TERM
PrintMotd no
